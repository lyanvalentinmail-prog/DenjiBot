{
  "name": "denji-bot",
  "version": "1.0.0",
  "type": "module",
  "description": "Denji bot - bot de WhatsApp con panel de control para Termux",
  "main": "launcher.ts",
  "author": "lyanvalentinmail-prog",
  "contributors": [
    "iamDestroy (YukiBot-MD)",
    "Ryuzei-Ts (Raiden-WaBot)"
  ],
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning launcher.ts",
    "bot": "node --disable-warning=ExperimentalWarning index.ts",
    "qr": "node --disable-warning=ExperimentalWarning index.ts --qr",
    "code": "node --disable-warning=ExperimentalWarning index.ts --code",
    "dev": "node --disable-warning=ExperimentalWarning --watch index.ts",
    "build": "tsc --noEmit"
  },
  "imports": {
    "#config": "./config.ts",
    "#simple": "./lib/simple.ts",
    "#serialize": "./lib/simple.ts",
    "#sticker": "./lib/stickers.ts",
    "#core/exif": "./lib/stickers.ts",
    "#core/latency": "./lib/latency.ts",
    "#core/signal-cache": "./lib/signal-cache.ts",
    "#db": "./lib/database.ts",
    "#handler": "./handler.ts",
    "#main": "./handler.ts",
    "#events": "./commands/events.js",
    "#loader": "./lib/cmdsLoader.ts",
    "#index": "./index.ts",
    "#alertas": "./lib/alertas.ts",
    "#settings": "./lib/settings.ts",
    "#interactive": "./lib/interactive.ts",
    "#menustyles": "./lib/menustyles.ts"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@vitalets/google-translate-api": "^9.2.1",
    "@whiskeysockets/baileys": "*",
    "axios": "^1.7.9",
    "chalk": "^5.4.1",
    "cheerio": "^1.0.0",
    "file-type": "^19.6.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.0",
    "grapheme-splitter": "^1.0.4",
    "human-readable": "^0.2.1",
    "lodash": "^4.17.21",
    "lodash.debounce": "^4.0.8",
    "lru-cache": "^11.0.2",
    "mime-types": "^2.1.35",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.46",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2",
    "node-webpmux": "^3.2.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "syntax-error": "^1.4.0",
    "ws": "^8.18.3",
    "yt-search": "^2.12.1"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/lodash": "^4.17.14",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "latest",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
